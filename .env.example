# ---------------------------------------------------------------------------
# PREPUMP — copy this file to .env.local and fill it in.
# .env.local is git-ignored. Never put a secret in a NEXT_PUBLIC_* variable:
# anything with that prefix is compiled into the browser bundle.
# ---------------------------------------------------------------------------

# --- Dev portal ------------------------------------------------------------
# /dev is always reachable in `npm run dev`. In production it only exists when
# DEV_PORTAL_ENABLED=true. The token below is optional: set it and every
# /api/dev/* call must carry it, leave it empty and no token is asked for.
DEV_PORTAL_ENABLED=false
DEV_PORTAL_ACCESS_TOKEN=

# simulate = nothing is broadcast, no SOL is spent, no token is created.
# live     = /dev performs a REAL pump.fun launch on mainnet with real SOL.
PREPUMP_EXECUTION_MODE=simulate

# --- Solana ----------------------------------------------------------------
# pump.fun only exists on mainnet, so a live launch needs a mainnet RPC.
# The public endpoint is rate limited; use Helius/QuickNode/Triton for real use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# The wallet that creates the token and pays for it. Base58 secret key (the
# "export private key" string from Phantom) or a JSON byte array from
# `solana-keygen`. Use a burner funded with only what a launch needs.
LAUNCH_WALLET_SECRET_KEY=

# Public deposit address, shown in /dev so a deployment can take deposits
# without holding the private key. Set it to the launch wallet's address.
NEXT_PUBLIC_DEPOSIT_ADDRESS=

# --- Round window (used by `npm run round`) --------------------------------
# The deposit wallet is the launch wallet above: people send SOL to that
# address, and the script reads everything that arrived inside this window.
ROUND_ID=1
ROUND_OPENS_AT=
ROUND_CLOSES_AT=
# How long a round is open, used when ROUND_OPENS_AT is left empty.
ROUND_LENGTH_HOURS=168
# Held back from the buy so the wallet can still pay fees and rent.
ROUND_RESERVE_SOL=0
# Share of the received tokens kept in the launch wallet.
DEV_CUT_PERCENT=0
# Rent for the mint, metadata and token accounts. Owed whatever the buy is.
# Measured at ~0.0071 SOL across real launches; this leaves a little margin.
ROUND_CREATE_COST_SOL=0.009
# pump.fun's cut of the dev buy, as a percentage. Measured at ~1.70%.
PUMPFUN_BUY_FEE_PERCENT=2
# Optional one-off direction for the generator, e.g. "a cursed vending machine".
ROUND_THEME=

# --- pump.fun launch parameters -------------------------------------------
# Dev buy performed in the same transaction as the create. 0 is allowed.
PUMPFUN_DEV_BUY_SOL=0.01
PUMPFUN_SLIPPAGE=10
PUMPFUN_PRIORITY_FEE=0.00001
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local

# Written into the token's metadata on IPFS.
TOKEN_LINK_TWITTER=
TOKEN_LINK_TELEGRAM=
TOKEN_LINK_WEBSITE=

# --- IPFS (token image + metadata) ----------------------------------------
# Optional. Leave PINATA_JWT empty and uploads go through pump.fun's own IPFS
# endpoint, which needs no account — that is what their website uses.
# Set a Pinata JWT if you would rather own the pin and the gateway.
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# --- OpenAI (meme generation) ---------------------------------------------
# Without a key the generator falls back to a local list and no artwork.
OPENAI_API_KEY=
# Text: gpt-5.6-luna is the cheap, fast one. gpt-5.6-terra / gpt-6-astra are
# stronger if you want weirder concepts.
OPENAI_MODEL=gpt-5.6-luna
# Artwork: gpt-image-2.5-flare is fast and good. gpt-image-2.5-sunburst is the
# most capable and slower.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
# The square the artwork is resized to before it is pinned to IPFS.
TOKEN_IMAGE_SIZE=512
